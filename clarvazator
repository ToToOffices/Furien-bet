#include <amxmodx>
#include <cstrike>
#include <fakemeta>

#define PLUGIN  "Clarvazator"
#define VERSION "1.0"
#define AUTHOR  "ChatGPT"

new bool:g_has_clarvazator[33];

public plugin_init()
{
    register_plugin(PLUGIN, VERSION, AUTHOR);

    register_event("DeathMsg", "event_DeathMsg", "a");

    register_forward(FM_AddToFullPack, "fw_AddToFullPack", 1);
}

/*
 * =========================================================
 * NATIVE-URI
 * =========================================================
 *
 * Din pluginul de cadouri:
 *
 * clarvazator_set(id, true);  // primeste
 * clarvazator_set(id, false); // pierde
 *
 * if (clarvazator_get(id))
 * {
 *     // are abilitatea
 * }
 */
public plugin_natives()
{
    register_native("clarvazator_set", "native_clarvazator_set");
    register_native("clarvazator_get", "native_clarvazator_get");
}

/*
 * clarvazator_set(id, bool:status)
 */
public native_clarvazator_set(plugin_id, num_params)
{
    new id = get_param(1);
    new bool:status = bool:get_param(2);

    if (id < 1 || id > 32)
        return 0;

    g_has_clarvazator[id] = status;

    return 1;
}

/*
 * clarvazator_get(id)
 */
public native_clarvazator_get(plugin_id, num_params)
{
    new id = get_param(1);

    if (id < 1 || id > 32)
        return 0;

    return g_has_clarvazator[id] ? 1 : 0;
}

/*
 * =========================================================
 * MOARTE
 * =========================================================
 *
 * La moarte pierde automat abilitatea.
 */
public event_DeathMsg()
{
    new victim = read_data(2);

    if (victim >= 1 && victim <= 32)
    {
        g_has_clarvazator[victim] = false;
    }
}

/*
 * =========================================================
 * DISCONNECT
 * =========================================================
 */
public client_disconnect(id)
{
    g_has_clarvazator[id] = false;
}

/*
 * =========================================================
 * VERIFICARE CUTIT
 * =========================================================
 */
bool:is_player_using_knife(id)
{
    if (!is_user_alive(id))
        return false;

    return (get_user_weapon(id) == CSW_KNIFE);
}

/*
 * =========================================================
 * CLARVAZATOR
 * =========================================================
 *
 * Efectul este trimis individual jucatorului care:
 *
 * 1. Are abilitatea Clarvazator
 * 2. Este viu
 * 3. Are cutitul scos
 *
 * Inamicii primesc GlowShell.
 */
public fw_AddToFullPack(es_handle, e, ent, host, hostflags, player, pSet)
{
    if (!player)
        return FMRES_IGNORED;

    // Hostul trebuie sa fie un jucator valid si viu.
    if (!is_user_alive(host))
        return FMRES_IGNORED;

    // Hostul trebuie sa aiba Clarvazator.
    if (!g_has_clarvazator[host])
        return FMRES_IGNORED;

    // Hostul trebuie sa aiba cutitul.
    if (!is_player_using_knife(host))
        return FMRES_IGNORED;

    // Entitatea trebuie sa fie un jucator viu.
    if (ent < 1 || ent > 32)
        return FMRES_IGNORED;

    if (!is_user_alive(ent))
        return FMRES_IGNORED;

    // Nu-si vede propriul glow.
    if (ent == host)
        return FMRES_IGNORED;

    // Doar inamicii.
    if (cs_get_user_team(ent) == cs_get_user_team(host))
        return FMRES_IGNORED;

    /*
     * Glow rosu pentru inamic.
     */
    static color[3];

    color[0] = 255;
    color[1] = 0;
    color[2] = 0;

    set_es(es_handle, ES_RenderFx, kRenderFxGlowShell);
    set_es(es_handle, ES_RenderMode, kRenderNormal);
    set_es(es_handle, ES_RenderAmt, 16);
    set_es(es_handle, ES_RenderColor, color);

    return FMRES_IGNORED;
}
